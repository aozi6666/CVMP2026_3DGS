%%
%% Local authblk.sty (from CTAN package `preprint`, LPPL).
%% TeX Live package name is `preprint`, NOT `authblk`:
%%   sudo tlmgr install preprint
%% This file is a project-local fallback so SPIE compiles under BasicTeX.
%%
\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{authblk}[2001/02/27 1.3 (PWD) local-fallback]

\newcounter{authors}
\newcounter{affil}
\newcommand{\Authfont}{\normalfont}
\newcommand{\Affilfont}{\normalfont\small}
\newcommand{\Authsep}{, }
\newcommand{\Authand}{ and }
\newcommand{\Authands}{, and }
\newlength{\affilsepwd}
\setlength{\affilsepwd}{1em}

\gdef\@author{}
\gdef\AB@affils{}

% Store each formatted author, then rebuild \@author so 3+ names
% become "A, B, and C" (old incremental Authand-on-2nd gave "A and B, C").
\renewcommand\author{\@ifnextchar[\author@i{\author@i[]}}
\def\author@i[#1]#2{%
  \stepcounter{authors}%
  \begingroup
    \let\protect\@unexpandable@protect
    \protected@xdef\AB@tmp@chunk{%
      {\Authfont #2%
       \ifx\relax#1\relax\else\textsuperscript{\normalfont#1}\fi}}%
  \endgroup
  \expandafter\let\csname AB@author@\theauthors\endcsname\AB@tmp@chunk
  \AB@rebuild@authorlist
}

\def\AB@rebuild@authorlist{%
  \gdef\@author{}%
  \begingroup
    \let\protect\@unexpandable@protect
    \count@=\z@
    \loop
      \advance\count@\@ne
    \ifnum\count@>\value{authors}\else
      \protected@xdef\@author{\@author
        \ifnum\count@>\@ne
          \ifnum\count@=\value{authors}
            \ifnum\value{authors}=\tw@ \Authand\else\Authands\fi
          \else
            \Authsep
          \fi
        \fi
        \csname AB@author@\the\count@\endcsname}%
    \repeat
  \endgroup
  \ifx\AB@affils\@empty\else
    \protected@xdef\@author{\@author\AB@affils}%
  \fi
}

\newcommand\affil{\@ifnextchar[\@affil@i{\@affil@i[]}}
\def\@affil@i[#1]#2{%
  \stepcounter{affil}%
  \begingroup
    \let\protect\@unexpandable@protect
    \protected@xdef\AB@affils{\AB@affils
      \\[\affilsepwd]
      {\Affilfont
       \ifx\relax#1\relax\else\textsuperscript{\normalfont#1}\,\fi
       #2}}%
    \protected@xdef\@author{\@author
      \\[\affilsepwd]
      {\Affilfont
       \ifx\relax#1\relax\else\textsuperscript{\normalfont#1}\,\fi
       #2}}%
  \endgroup
}

\endinput
